#!/usr/bin/env bash
# bin/agent-sandbox — Generic Bubblewrap sandbox runner for AI coding agents
# Supports multi-account profile isolation across:
#   - antigravity (agy, antigravity)
#   - claude (claude, claude-code)
#   - codex (codex)
#   - opencode (opencode)
#   - opencode2 (opencode2, opencode-v2)
#   - pi (pi)
#   - orca (orca)
#
# Usage:
#   agent-sandbox <agent> --list-profile
#   agent-sandbox <agent> --profile <profile_name> [agent args...]
#   agent-sandbox <agent> [agent args...]  (runs agent directly on host)
#   agent-sandbox --list-profile           (lists profiles across all agents)
#   agent-sandbox --version
#
set -euo pipefail

AGENT_SANDBOX_VERSION="0.0.1"

# Determine base directory for storing agent profiles
if [ -n "${AGENT_SANDBOX_BASE:-}" ]; then
  SANDBOX_BASE="$AGENT_SANDBOX_BASE"
elif [ -d "/opt/config/agent-sandbox" ]; then
  SANDBOX_BASE="/opt/config/agent-sandbox"
elif [ -d "/opt/config" ] && [ -w "/opt/config" ]; then
  SANDBOX_BASE="/opt/config/agent-sandbox"
elif [ -n "${XDG_DATA_HOME:-}" ]; then
  SANDBOX_BASE="${XDG_DATA_HOME}/agent-sandbox"
else
  SANDBOX_BASE="${HOME}/.local/share/agent-sandbox"
fi

OWNER="${AGENT_SANDBOX_OWNER:-${USER:-$(id -un 2>/dev/null || echo "user")}}"

# Global skills directory that is linked into newly created profiles
if [ -n "${AGENT_SANDBOX_SKILLS:-}" ]; then
  SANDBOX_SKILLS="$AGENT_SANDBOX_SKILLS"
elif [ -d "/opt/config/.agents/skills" ]; then
  SANDBOX_SKILLS="/opt/config/.agents/skills"
else
  SANDBOX_SKILLS="${HOME}/.agents/skills"
fi

# ------------------------------------------------------------------------------
# Usage & Help
# ------------------------------------------------------------------------------
usage() {
  cat <<'EOF'
agent-sandbox — Isolated profile sandbox runner for AI coding agents

USAGE:
  agent-sandbox <agent> --list-profile
      List existing profiles and status for the specified agent.

  agent-sandbox <agent> --profile <profile_name> [args...]
      Launch the agent inside an isolated Bubblewrap sandbox under
      <sandbox_base>/<agent>/<profile_name>.

  agent-sandbox <agent> --profile <profile_name> [--ipv4 <v>] [--ipv6 <v>] [args...]
      Choose the address the profile uses for outbound traffic. <v> is an
      address, 'host' (host routing), 'none'/'null' (disable that family),
      'new' (reserve one through the net hook; the same profile always gets the
      same address) or 'default' (forget the saved choice, use the default
      policy). The choice is saved per agent/profile and reused next time. With
      no flag and nothing saved, the default policy applies: AGENT_SANDBOX_DEFAULT_IPV4/6
      (or <sandbox_base>/.net/defaults.conf), 'host' when unset. A saved address
      that is no longer available falls back to the host address (logged).

  agent-sandbox <agent> [args...]
      Run the agent command directly on the host (passes through all arguments).

  agent-sandbox --list-profile
      List profiles across all supported agents.

  agent-sandbox --auto-clean [<agent>] [--days N] [--dry-run] [--yes] [-i|--interactive]
      Remove profiles that are not authenticated (status New or Initialized) and
      unchanged for N days (default 7; 0 = any age), with their saved network
      choice and reserved address. Lists them and asks first; --dry-run only
      lists, --yes skips the question. Authenticated profiles are never touched.
      -i/--interactive instead shows a numbered list of ALL profiles (* marks what
      would be auto-cleaned), lets you pick which to remove (1,3-5 or a), and asks to
      confirm; picking a profile with credentials needs the word 'delete'.

SUPPORTED AGENTS & ALIASES:
  antigravity, agy    -> Google Antigravity CLI
  claude, claude-code -> Anthropic Claude Code
  codex               -> OpenAI Codex CLI
  opencode            -> OpenCode AI
  opencode2           -> OpenCode 2
  pi                  -> Pi Coding Agent
  orca                -> Orca ADE

ENVIRONMENT VARIABLES:
  AGENT_SANDBOX_BASE    Base directory for profiles (default: /opt/config/agent-sandbox or ~/.local/share/agent-sandbox)
  AGENT_SANDBOX_OWNER   Primary user name (default: current user)
  AGENT_SANDBOX_SKILLS  Skills directory linked into new profiles (default: /opt/config/.agents/skills or ~/.agents/skills)
  AGENT_SANDBOX_NET_ENV File that may set SANDBOX_IPV6 (default: <sandbox_base>/net.env)
  AGENT_SANDBOX_NET_HOOK  Executable that reserves/ensures addresses
                          (default: <sandbox_base>/net-hook; see examples/)
  AGENT_SANDBOX_DEFAULT_IPV4 / AGENT_SANDBOX_DEFAULT_IPV6
                          Default policy for profiles with no flag and nothing
                          saved: new, none, an address, or host (default)
  AGENT_SANDBOX_DRY_RUN   1 = print the final command instead of running it

EXAMPLES:
  agent-sandbox claude --profile work --ipv6 new
  agent-sandbox claude --profile work --ipv4 none
  AGENT_SANDBOX_DEFAULT_IPV6=new agent-sandbox claude --profile work   (auto-reserve once, then reuse)
  agent-sandbox claude --list-profile
  agent-sandbox agy --profile work -p "Check git status"
  agent-sandbox claude --profile personal
  agent-sandbox codex --profile client-a
  agent-sandbox agy --version  (runs agy directly on host)
EOF
}

# ------------------------------------------------------------------------------
# Agent Normalization
# ------------------------------------------------------------------------------
resolve_agent() {
  local raw="$1"
  case "$raw" in
    antigravity|agy)
      echo "antigravity"
      ;;
    claude|claude-code)
      echo "claude"
      ;;
    codex)
      echo "codex"
      ;;
    opencode)
      echo "opencode"
      ;;
    opencode2|opencode-v2)
      echo "opencode2"
      ;;
    pi)
      echo "pi"
      ;;
    orca)
      echo "orca"
      ;;
    *)
      echo ""
      ;;
  esac
}

# ------------------------------------------------------------------------------
# Agent Binary Resolution
# ------------------------------------------------------------------------------
get_agent_binary() {
  local agent="$1"
  case "$agent" in
    antigravity)
      if [ -x "/opt/antigravity/bin/agy" ]; then echo "/opt/antigravity/bin/agy"
      elif [ -x "/opt/config/bin/agy" ]; then echo "/opt/config/bin/agy"
      elif [ -x "$HOME/.local/bin/agy" ]; then echo "$HOME/.local/bin/agy"
      else command -v agy 2>/dev/null || command -v antigravity 2>/dev/null || true; fi
      ;;
    claude)
      if [ -x "/opt/config/bin/claude" ]; then echo "/opt/config/bin/claude"
      elif [ -x "/opt/claude/bin/claude" ]; then echo "/opt/claude/bin/claude"
      elif [ -x "$HOME/.local/bin/claude" ]; then echo "$HOME/.local/bin/claude"
      else command -v claude 2>/dev/null || command -v claude-code 2>/dev/null || true; fi
      ;;
    codex)
      if [ -x "/opt/config/bin/codex" ]; then echo "/opt/config/bin/codex"
      elif [ -x "/opt/codex/bin/codex" ]; then echo "/opt/codex/bin/codex"
      elif [ -x "$HOME/.local/bin/codex" ]; then echo "$HOME/.local/bin/codex"
      else command -v codex 2>/dev/null || true; fi
      ;;
    opencode)
      if [ -x "/opt/config/bin/opencode" ]; then echo "/opt/config/bin/opencode"
      elif [ -x "/opt/opencode/bin/opencode" ]; then echo "/opt/opencode/bin/opencode"
      elif [ -x "$HOME/.local/bin/opencode" ]; then echo "$HOME/.local/bin/opencode"
      else command -v opencode 2>/dev/null || true; fi
      ;;
    opencode2)
      if [ -x "/opt/config/bin/opencode2" ]; then echo "/opt/config/bin/opencode2"
      elif [ -x "/opt/opencode2/bin/opencode2" ]; then echo "/opt/opencode2/bin/opencode2"
      elif [ -x "$HOME/.local/bin/opencode2" ]; then echo "$HOME/.local/bin/opencode2"
      else command -v opencode2 2>/dev/null || command -v opencode-v2 2>/dev/null || true; fi
      ;;
    pi)
      if [ -x "/opt/config/bin/pi" ]; then echo "/opt/config/bin/pi"
      elif [ -x "/opt/pi/bin/pi" ]; then echo "/opt/pi/bin/pi"
      elif [ -x "$HOME/.local/bin/pi" ]; then echo "$HOME/.local/bin/pi"
      else command -v pi 2>/dev/null || true; fi
      ;;
    orca)
      if [ -x "/opt/config/bin/orca" ]; then echo "/opt/config/bin/orca"
      elif [ -x "/opt/orca/orca" ]; then echo "/opt/orca/orca"
      elif [ -x "$HOME/.local/bin/orca" ]; then echo "$HOME/.local/bin/orca"
      else command -v orca 2>/dev/null || true; fi
      ;;
    *)
      echo ""
      ;;
  esac
}

# ------------------------------------------------------------------------------
# Profile Status Inspector
# ------------------------------------------------------------------------------
inspect_profile_status() {
  local agent="$1"
  local profile_dir="$2"

  case "$agent" in
    antigravity)
      if [ -f "$profile_dir/antigravity-cli/antigravity-oauth-token" ]; then
        echo "Authenticated"
      elif [ -d "$profile_dir/antigravity-cli" ]; then
        echo "Initialized"
      else
        echo "New"
      fi
      ;;
    claude)
      if [ -f "$profile_dir/.credentials.json" ] || [ -f "$profile_dir/.claude.json" ] || [ -f "$profile_dir/claude.json" ]; then
        echo "Authenticated"
      elif [ -d "$profile_dir" ] && [ "$(ls -A "$profile_dir" 2>/dev/null)" ]; then
        echo "Initialized"
      else
        echo "New"
      fi
      ;;
    codex)
      if [ -f "$profile_dir/auth.json" ]; then
        echo "Authenticated"
      elif [ -f "$profile_dir/config.toml" ]; then
        echo "Configured"
      else
        echo "New"
      fi
      ;;
    opencode)
      if [ -f "$profile_dir/config/auth.json" ] || [ -f "$profile_dir/data/opencode.db" ]; then
        echo "Active"
      elif [ -d "$profile_dir/config" ] || [ -d "$profile_dir/data" ]; then
        echo "Initialized"
      else
        echo "New"
      fi
      ;;
    opencode2)
      if [ -f "$profile_dir/service.json" ] || [ -f "$profile_dir/cli.json" ]; then
        echo "Active"
      elif [ -d "$profile_dir" ] && [ "$(ls -A "$profile_dir" 2>/dev/null)" ]; then
        echo "Initialized"
      else
        echo "New"
      fi
      ;;
    pi)
      if [ -f "$profile_dir/auth.json" ] || [ -f "$profile_dir/models-store.json" ]; then
        echo "Configured"
      elif [ -d "$profile_dir" ] && [ "$(ls -A "$profile_dir" 2>/dev/null)" ]; then
        echo "Initialized"
      else
        echo "New"
      fi
      ;;
    orca)
      if [ -f "$profile_dir/home_orca/orca-runtime.json" ] || [ -f "$profile_dir/home_orca/orchestration.db" ]; then
        echo "Active"
      elif [ -d "$profile_dir/user_data" ] || [ -d "$profile_dir/home_orca" ]; then
        echo "Initialized"
      else
        echo "New"
      fi
      ;;
    *)
      echo "Unknown"
      ;;
  esac
}

# ------------------------------------------------------------------------------
# List Profiles (Table Format)
# ------------------------------------------------------------------------------
list_profiles() {
  local target_agent="${1:-all}"
  local agents_to_check=()

  if [ "$target_agent" = "all" ] || [ -z "$target_agent" ]; then
    agents_to_check=(antigravity claude codex opencode opencode2 pi orca)
  else
    agents_to_check=("$target_agent")
  fi

  local found_any=0
  local rows=()

  for ag in "${agents_to_check[@]}"; do
    local base_dir="$SANDBOX_BASE/$ag"
    # Check legacy antigravity-sandbox location if present
    if [ "$ag" = "antigravity" ] && [ ! -d "$base_dir" ] && [ -d "/opt/config/antigravity-sandbox/accounts" ]; then
      base_dir="/opt/config/antigravity-sandbox/accounts"
    fi

    [ -d "$base_dir" ] || continue

    for p_path in "$base_dir"/*; do
      [ -d "$p_path" ] || continue
      local p_name
      p_name="$(basename "$p_path")"
      # Skip hidden or reserved items
      [[ "$p_name" == .* ]] && continue

      local p_size p_mod p_status
      p_size="$(du -sh "$p_path" 2>/dev/null | awk '{print $1}')"
      p_size="${p_size:-0B}"

      if stat -c '%y' "$p_path" >/dev/null 2>&1; then
        p_mod="$(stat -c '%y' "$p_path" | cut -c1-16)"
      elif stat -f '%Sm' -t '%Y-%m-%d %H:%M' "$p_path" >/dev/null 2>&1; then
        p_mod="$(stat -f '%Sm' -t '%Y-%m-%d %H:%M' "$p_path")"
      else
        p_mod="N/A"
      fi

      p_status="$(inspect_profile_status "$ag" "$p_path")"

      rows+=("$ag|$p_name|$p_size|$p_mod|$p_status|$p_path")
      found_any=1
    done
  done

  if [ "$found_any" -eq 0 ]; then
    if [ "$target_agent" != "all" ]; then
      echo "No profiles found for '$target_agent' under $SANDBOX_BASE/$target_agent/"
      echo "Create one with: agent-sandbox $target_agent --profile <name>"
    else
      echo "No sandbox profiles found under $SANDBOX_BASE/"
      echo "Create one with: agent-sandbox <agent> --profile <name>"
    fi
    return 0
  fi

  # Render ASCII Table
  echo "+-------------+----------------------+----------+-------------------+----------------+-------------------------------------------------------------+"
  printf "| %-11s | %-20s | %-8s | %-17s | %-14s | %-59s |\n" "Agent" "Profile" "Size" "Last Modified" "Status" "Directory"
  echo "+-------------+----------------------+----------+-------------------+----------------+-------------------------------------------------------------+"
  for row in "${rows[@]}"; do
    IFS='|' read -r r_ag r_name r_size r_mod r_stat r_dir <<< "$row"
    printf "| %-11s | %-20s | %-8s | %-17s | %-14s | %-59s |\n" "$r_ag" "$r_name" "$r_size" "$r_mod" "$r_stat" "$r_dir"
  done
  echo "+-------------+----------------------+----------+-------------------+----------------+-------------------------------------------------------------+"

  # Saved per-profile network choices (see --ipv4/--ipv6)
  local net_hdr=0 r_conf
  for row in "${rows[@]}"; do
    IFS='|' read -r r_ag r_name _ <<< "$row"
    r_conf="$(net_conf_file "$r_ag" "$r_name")"
    [ -s "$r_conf" ] || continue
    if [ "$net_hdr" -eq 0 ]; then echo "Network overrides:"; net_hdr=1; fi
    printf '  %s/%s: %s\n' "$r_ag" "$r_name" "$(tr '\n' ' ' < "$r_conf")"
  done
}

# ------------------------------------------------------------------------------
# Auto-clean: remove profiles that are unused and not authenticated
# ------------------------------------------------------------------------------
# auto_clean <agent|all> <days> <dry_run> <yes>
# A profile is removed when its status is New or Initialized (no credentials, see
# inspect_profile_status) and nothing in it changed in the last <days> days.
auto_clean() {
  local target="$1" days="$2" dry="$3" yes="$4"
  local agents=() victims=() ag p_path p_name v answer
  if [ "$target" = all ]; then agents=(antigravity claude codex opencode opencode2 pi orca); else agents=("$target"); fi

  for ag in "${agents[@]}"; do
    for p_path in "$SANDBOX_BASE/$ag"/*; do
      [ -d "$p_path" ] && [ ! -L "$p_path" ] || continue
      case "$(inspect_profile_status "$ag" "$p_path")" in New|Initialized) ;; *) continue ;; esac
      [ -z "$(find "$p_path" -mtime "-$days" -print -quit 2>/dev/null)" ] || continue
      victims+=("$ag|$(basename "$p_path")|$p_path")
    done
  done

  if [ ${#victims[@]} -eq 0 ]; then
    echo "Nothing to clean (no unauthenticated profile unused for $days+ days)."
    return 0
  fi
  echo "Unauthenticated profiles unused for $days+ days:"
  for v in "${victims[@]}"; do IFS='|' read -r ag p_name p_path <<< "$v"; printf '  %s/%s  (%s)\n' "$ag" "$p_name" "$p_path"; done
  [ "$dry" = 1 ] && return 0

  if [ "$yes" != 1 ]; then
    [ -t 0 ] || { echo "[agent-sandbox] ERROR: not a terminal; pass --yes to delete, or --dry-run to only list" >&2; return 1; }
    read -r -p "Delete ${#victims[@]} profile(s)? [y/N] " answer
    [[ "$answer" =~ ^[Yy]$ ]] || { echo "Aborted."; return 1; }
  fi

  for v in "${victims[@]}"; do
    IFS='|' read -r ag p_name p_path <<< "$v"
    remove_profile "$ag" "$p_name" "$p_path"
  done
}

# remove_profile <agent> <name> <dir>: the profile, its saved network choice and its reserved address
remove_profile() {
  rm -rf -- "$3"
  rm -f -- "$(net_conf_file "$1" "$2")"
  net_hook release "$1" "$2" >/dev/null 2>&1 || true   # frees the reserved address; no hook = nothing to free
  echo "removed $1/$2"
}

# clean_interactive <agent|all> <days> <dry_run>: pick profiles to remove from a numbered list.
# Reads from stdin (not required to be a terminal). Any profile can be picked; authenticated
# ones need the word "delete" typed. * marks what plain --auto-clean would remove.
clean_interactive() {
  local target="$1" days="$2" dry="$3"
  local agents=() rows=() ag p_path st mark n i row chosen=" " sel tok a b answer need_word=0
  if [ "$target" = all ]; then agents=(antigravity claude codex opencode opencode2 pi orca); else agents=("$target"); fi

  for ag in "${agents[@]}"; do
    for p_path in "$SANDBOX_BASE/$ag"/*; do
      [ -d "$p_path" ] && [ ! -L "$p_path" ] || continue
      st="$(inspect_profile_status "$ag" "$p_path")"; mark=" "
      case "$st" in New|Initialized) [ -n "$(find "$p_path" -mtime "-$days" -print -quit 2>/dev/null)" ] || mark="*" ;; esac
      rows+=("$ag|$(basename "$p_path")|$st|$mark|$p_path")
    done
  done
  n=${#rows[@]}
  if [ "$n" -eq 0 ]; then echo "No profiles found under $SANDBOX_BASE/."; return 0; fi

  i=0
  for row in "${rows[@]}"; do
    i=$((i + 1)); IFS='|' read -r ag p_name st mark p_path <<< "$row"
    printf '%3d) %s %-12s %-20s %-14s %s\n' "$i" "$mark" "$ag" "$p_name" "$st" "$p_path"
  done
  echo "* = not authenticated and unused for $days+ days (what --auto-clean removes)"
  read -r -p "Remove which? numbers or ranges (1,3-5), a = all *, q = quit: " sel || return 0

  for tok in ${sel//,/ }; do
    case "$tok" in
      q|Q) return 0 ;;
      a|A) i=0; for row in "${rows[@]}"; do i=$((i + 1)); case "$row" in *"|*|"*) chosen+="$i " ;; esac; done ;;
      *[!0-9-]*|""|-*|*-|*-*-*) echo "[agent-sandbox] ERROR: can't read '$tok'" >&2; return 1 ;;
      *-*) a="${tok%-*}"; b="${tok#*-}"
           { [ "$a" -ge 1 ] && [ "$b" -le "$n" ] && [ "$a" -le "$b" ]; } || { echo "[agent-sandbox] ERROR: bad range '$tok' (1-$n)" >&2; return 1; }
           for ((i = a; i <= b; i++)); do chosen+="$i "; done ;;
      *)   { [ "$tok" -ge 1 ] && [ "$tok" -le "$n" ]; } || { echo "[agent-sandbox] ERROR: no number $tok (1-$n)" >&2; return 1; }
           chosen+="$tok " ;;
    esac
  done
  if [ "$chosen" = " " ]; then echo "Nothing selected."; return 0; fi

  echo "Selected:"
  i=0
  for row in "${rows[@]}"; do
    i=$((i + 1)); case "$chosen" in *" $i "*) ;; *) continue ;; esac
    IFS='|' read -r ag p_name st mark p_path <<< "$row"
    printf '  %s/%s  [%s]\n' "$ag" "$p_name" "$st"
    case "$st" in New|Initialized) ;; *) need_word=1 ;; esac
  done
  if [ "$dry" = 1 ]; then echo "Dry run: nothing removed."; return 0; fi

  if [ "$need_word" = 1 ]; then
    read -r -p "This includes profile(s) with credentials. Type 'delete' to confirm: " answer || answer=""
    [ "$answer" = delete ] || { echo "Aborted."; return 1; }
  else
    read -r -p "Delete these profile(s)? [y/N] " answer || answer=""
    [[ "$answer" =~ ^[Yy]$ ]] || { echo "Aborted."; return 1; }
  fi

  i=0
  for row in "${rows[@]}"; do
    i=$((i + 1)); case "$chosen" in *" $i "*) ;; *) continue ;; esac
    IFS='|' read -r ag p_name st mark p_path <<< "$row"
    remove_profile "$ag" "$p_name" "$p_path"
  done
}

# ------------------------------------------------------------------------------
# Direct Execution (No Sandbox)
# ------------------------------------------------------------------------------
run_direct() {
  local agent="$1"
  shift
  local bin
  bin="$(get_agent_binary "$agent")"

  if [ -z "$bin" ] || [ ! -x "$bin" ]; then
    echo "[agent-sandbox] ERROR: Cannot locate binary for '$agent'" >&2
    exit 1
  fi

  case "$agent" in
    claude)
      [ -d "/opt/claude" ] && export NPM_CONFIG_PREFIX="/opt/claude"
      ;;
    opencode2)
      [ -d "/opt/config/opencode2" ] && export OPENCODE_CONFIG_DIR="${OPENCODE2_CONFIG_DIR:-/opt/config/opencode2}"
      ;;
  esac

  exec "$bin" "$@"
}

# ------------------------------------------------------------------------------
# Per-profile network (IPv4 / IPv6)
# ------------------------------------------------------------------------------
# Each family is "host" (host routing), "none" (disabled) or an address.
# Resolution order: --ipv4/--ipv6 flag, saved config, default. Any non-default
# value runs the agent under pasta (userspace netns) with outbound sockets bound
# to the address. Addresses are reserved by an optional hook, see examples/.
NET_DIR="$SANDBOX_BASE/.net"
DRY_RUN="${AGENT_SANDBOX_DRY_RUN:-0}"
NET_PREFIX=()
NET_BWRAP=()

net_log() { echo "[agent-sandbox] $*" >&2; }
net_die() { net_log "ERROR: $*"; exit 1; }

# net_norm <ipv4|ipv6> <value>: print the normalized value, fail if invalid
net_norm() {
  local v
  v="$(printf '%s' "$2" | tr 'A-Z' 'a-z')"
  case "$v" in
    default|host|none|new) echo "$v"; return 0 ;;
    null) echo none; return 0 ;;
  esac
  case "$1" in
    ipv4) [[ "$v" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1 ;;
    ipv6) [[ "$v" =~ ^[0-9a-f:]+$ && "$v" == *:* ]] || return 1 ;;
  esac
  echo "$v"
}

# net_flag <--ipv4|--ipv6> <value>: record a command-line choice
net_flag() {
  local fam="${1#--}" v
  v="$(net_norm "$fam" "$2")" || net_die "invalid value '$2' for $1 (address, host, none, new or default)"
  printf -v "NET_FLAG_$fam" %s "$v"
}

# net_policy <family>: what a profile with no flag and nothing saved gets.
# AGENT_SANDBOX_DEFAULT_IPV4/6 or <base>/.net/defaults.conf; 'host' when unset.
net_policy() {
  local v=""
  case "$1" in
    ipv4) v="${AGENT_SANDBOX_DEFAULT_IPV4:-}" ;;
    ipv6) v="${AGENT_SANDBOX_DEFAULT_IPV6:-}" ;;
  esac
  [ -n "$v" ] || v="$(net_conf_get "$NET_DIR/defaults.conf" "$1")"
  [ -n "$v" ] || { echo host; return 0; }
  v="$(net_norm "$1" "$v" || true)"
  case "$v" in
    ""|default) net_log "WARN: ignoring invalid default policy for $1"; echo host ;;
    *) echo "$v" ;;
  esac
}

net_conf_file() { echo "$NET_DIR/$1/${2//\//_}.conf"; }

net_conf_get() { { [ -f "$1" ] && sed -n "s/^$2=//p" "$1" | tail -n 1; } || true; }

# net_conf_set <file> <family> <value>: empty value removes the key
net_conf_set() {
  local tmp
  mkdir -p "$(dirname "$1")"
  tmp="$(mktemp "$1.XXXXXX")"
  { { [ -f "$1" ] && grep -v "^$2=" "$1"; } || true; [ -z "$3" ] || echo "$2=$3"; } > "$tmp"
  mv "$tmp" "$1"
}

# net_hook <action> <args...>: 127 when no hook is installed
net_hook() {
  local hook="${AGENT_SANDBOX_NET_HOOK:-$SANDBOX_BASE/net-hook}"
  [ -x "$hook" ] || return 127
  AGENT_SANDBOX_BASE="$SANDBOX_BASE" "$hook" "$@"
}

net_present() { [ -n "$(ip -o addr show to "$1" 2>/dev/null)" ]; }

# net_default_addr <ipv4|ipv6>: source address the host would pick, best effort
net_default_addr() {
  local fam=-4 dst=1.1.1.1
  if [ "$1" = ipv6 ]; then fam=-6; dst=2606:4700:4700::1111; fi
  ip "$fam" route get "$dst" 2>/dev/null | sed -n 's/.* src \([^ ]*\).*/\1/p' | head -n 1 || true
}

# net_resolve <family> <flag> <conf> <agent> <profile>
# Sets NET_VAL_<family> and NET_SRC_<family> (flag|saved|auto|default|fallback).
net_resolve() {
  local fam="$1" flag="$2" conf="$3" agent="$4" profile="$5" want src saved persist=0
  saved="$(net_conf_get "$conf" "$fam")"
  if [ -n "$saved" ]; then
    saved="$(net_norm "$fam" "$saved" || true)"
    case "$saved" in
      ""|new|default) net_log "WARN: ignoring invalid saved $fam in $conf"; saved="" ;;
    esac
  fi

  # 'default' forgets the saved choice and falls back to the default policy
  if [ "$flag" = default ]; then flag=""; saved=""; net_conf_set "$conf" "$fam" ""; fi

  if [ -n "$flag" ]; then want="$flag"; src=flag; persist=1
  elif [ -n "$saved" ]; then want="$saved"; src=saved
  else
    want="$(net_policy "$fam")"; src=auto
    if [ "$want" = host ]; then src=default; fi
  fi

  if [ "$want" = new ]; then
    if [ "$src" = auto ]; then persist=1; fi
    want="$(net_hook reserve "$fam" "$agent" "$profile")" \
      || net_die "cannot reserve a new $fam address (is AGENT_SANDBOX_NET_HOOK set? see examples/)"
    want="$(net_norm "$fam" "$want")" || net_die "net hook returned an invalid $fam address"
    case "$want" in default|host|none|new) net_die "net hook returned '$want', expected an address" ;; esac
  fi

  case "$want" in
    host|none) ;;
    *)
      net_present "$want" || net_hook ensure "$fam" "$want" "$agent" "$profile" >/dev/null || true
      if ! net_present "$want"; then
        if [ "$src" = flag ]; then net_die "$fam address $want is not configured on this host"; fi
        net_log "WARN: $fam $want ($src) is not available, using the host address"
        want=host; src=fallback
      fi
      ;;
  esac

  if [ "$persist" = 1 ] && [ "$src" != fallback ]; then net_conf_set "$conf" "$fam" "$want"; fi
  printf -v "NET_VAL_$fam" %s "$want"
  printf -v "NET_SRC_$fam" %s "$src"
}

net_need_pasta() {
  if [ "$DRY_RUN" = 1 ]; then return 0; fi
  command -v pasta >/dev/null 2>&1 || net_die "'pasta' not found (Debian/Ubuntu: apt install passt)"
  { [ -c /dev/net/tun ] && [ -w /dev/net/tun ]; } \
    || net_die "/dev/net/tun is missing or not writable; pasta needs it (Proxmox LXC: pct set <id> --dev0 /dev/net/tun,mode=0666, then restart the container)"
}

# net_prepare <agent> <profile>: resolve both families, log, fill NET_PREFIX/NET_BWRAP
net_prepare() {
  local conf v4 v6 s4 s6
  conf="$(net_conf_file "$1" "$2")"
  net_resolve ipv4 "${NET_FLAG_ipv4:-}" "$conf" "$1" "$2"
  net_resolve ipv6 "${NET_FLAG_ipv6:-}" "$conf" "$1" "$2"
  v4="$NET_VAL_ipv4"; v6="$NET_VAL_ipv6"

  s4="$v4"; if [ "$v4" = host ]; then s4="$(net_default_addr ipv4)"; s4="${s4:-host}"; fi
  s6="$v6"; if [ "$v6" = host ]; then s6="$(net_default_addr ipv6)"; s6="${s6:-host}"; fi
  net_log "net $1/$2: ipv4=$s4 ($NET_SRC_ipv4) ipv6=$s6 ($NET_SRC_ipv6)"

  NET_PREFIX=(); NET_BWRAP=()
  if [ "$v4" = none ] && [ "$v6" = none ]; then
    NET_BWRAP=(--unshare-net)
  elif [ "$v4" != host ] || [ "$v6" != host ]; then
    net_need_pasta
    NET_PREFIX=(pasta --config-net)
    if [ "$v6" = none ]; then NET_PREFIX+=(-4); fi
    if [ "$v4" = none ]; then NET_PREFIX+=(-6); fi
    case "$v4" in host|none) ;; *) NET_PREFIX+=(-o "$v4") ;; esac
    case "$v6" in host|none) ;; *) NET_PREFIX+=(-o "$v6") ;; esac
    NET_PREFIX+=(--)
  fi
}

# ------------------------------------------------------------------------------
# Sandboxed Execution (Bubblewrap)
# ------------------------------------------------------------------------------
run_sandbox() {
  local agent="$1"
  local profile="$2"
  shift 2
  local forward_args=("$@")

  if ! command -v bwrap >/dev/null 2>&1; then
    echo "[agent-sandbox] ERROR: 'bwrap' (bubblewrap) is not installed." >&2
    echo "[agent-sandbox] Install via your package manager:" >&2
    echo "  Debian/Ubuntu: sudo apt install bubblewrap" >&2
    echo "  Fedora:        sudo dnf install bubblewrap" >&2
    echo "  Arch Linux:    sudo pacman -S bubblewrap" >&2
    echo "  Alpine:        sudo apk add bubblewrap" >&2
    exit 1
  fi

  local real_bin
  real_bin="$(get_agent_binary "$agent")"
  if [ -z "$real_bin" ] || [ ! -x "$real_bin" ]; then
    echo "[agent-sandbox] ERROR: Cannot locate binary for '$agent'" >&2
    exit 1
  fi

  net_prepare "$agent" "$profile"

  # Determine profile directory
  local profile_dir
  if [[ "$profile" = /* ]]; then
    profile_dir="$profile"
  else
    profile_dir="$SANDBOX_BASE/$agent/$profile"
  fi

  mkdir -p "$profile_dir"

  # Declare mount pairs: host_source -> in_sandbox_target
  local mount_pairs=()
  local env_vars=()

  case "$agent" in
    antigravity)
      mkdir -p "$profile_dir/antigravity-cli" "$profile_dir/config"
      # If current directory is within antigravity config tree, ensure relative subpath exists in profile
      case "$PWD" in
        /opt/config/antigravity/*) mkdir -p "$profile_dir/${PWD#/opt/config/antigravity/}" ;;
        "$HOME"/.gemini/*)         mkdir -p "$profile_dir/${PWD#$HOME/.gemini/}" ;;
        "$HOME"/.antigravity/*)    mkdir -p "$profile_dir/${PWD#$HOME/.antigravity/}" ;;
      esac
      [ ! -e "$profile_dir/skills" ] && [ -d "$SANDBOX_SKILLS" ] && ln -sfn "$SANDBOX_SKILLS" "$profile_dir/skills"
      if [ ! -f "$profile_dir/config/mcp_config.json" ] && [ -f "/opt/config/antigravity/config/mcp_config.json" ]; then
        cp -p "/opt/config/antigravity/config/mcp_config.json" "$profile_dir/config/mcp_config.json"
      fi

      [ -d "/opt/config/antigravity" ] && mount_pairs+=("$profile_dir|/opt/config/antigravity")
      if [ ! -L "$HOME/.gemini" ]; then
        mkdir -p "$HOME/.gemini"
        mount_pairs+=("$profile_dir|$HOME/.gemini")
      fi
      if [ ! -L "$HOME/.antigravity" ]; then
        mkdir -p "$HOME/.antigravity"
        mount_pairs+=("$profile_dir|$HOME/.antigravity")
      fi

      env_vars+=(
        "ANTIGRAVITY_APP_DATA_DIR=/opt/config/antigravity"
        "ANTIGRAVITY_GEMINI_DIR=/opt/config/antigravity"
        "AGY_PROFILE=$profile_dir"
      )
      ;;

    claude)
      mkdir -p "$profile_dir"
      case "$PWD" in
        /opt/config/claude/*) mkdir -p "$profile_dir/${PWD#/opt/config/claude/}" ;;
        "$HOME"/.claude/*)    mkdir -p "$profile_dir/${PWD#$HOME/.claude/}" ;;
      esac
      [ ! -e "$profile_dir/skills" ] && [ -d "$SANDBOX_SKILLS" ] && ln -sfn "$SANDBOX_SKILLS" "$profile_dir/skills"
      [ ! -e "$profile_dir/rules" ] && [ -d "$HOME/.agents/rules" ] && ln -sfn "$HOME/.agents/rules" "$profile_dir/rules"

      [ -d "/opt/config/claude" ] && mount_pairs+=("$profile_dir|/opt/config/claude")
      if [ ! -L "$HOME/.claude" ]; then
        mkdir -p "$HOME/.claude"
        mount_pairs+=("$profile_dir|$HOME/.claude")
      fi

      env_vars+=(
        "CLAUDE_CONFIG_DIR=${CLAUDE_CONFIG_DIR:-/opt/config/claude}"
        "CLAUDE_PROFILE=$profile_dir"
      )
      [ -d "/opt/claude" ] && env_vars+=("NPM_CONFIG_PREFIX=/opt/claude")
      ;;

    codex)
      mkdir -p "$profile_dir"
      case "$PWD" in
        /opt/config/codex/*) mkdir -p "$profile_dir/${PWD#/opt/config/codex/}" ;;
        "$HOME"/.codex/*)    mkdir -p "$profile_dir/${PWD#$HOME/.codex/}" ;;
      esac
      [ ! -e "$profile_dir/skills" ] && [ -d "$SANDBOX_SKILLS" ] && ln -sfn "$SANDBOX_SKILLS" "$profile_dir/skills"

      [ -d "/opt/config/codex" ] && mount_pairs+=("$profile_dir|/opt/config/codex")
      if [ ! -L "$HOME/.codex" ]; then
        mkdir -p "$HOME/.codex"
        mount_pairs+=("$profile_dir|$HOME/.codex")
      fi

      env_vars+=(
        "CODEX_HOME=${CODEX_HOME:-/opt/config/codex}"
        "CODEX_PROFILE=$profile_dir"
      )
      ;;

    opencode)
      # Multi-folder agent: config and data subdirectories
      mkdir -p "$profile_dir/config" "$profile_dir/data"
      case "$PWD" in
        /opt/config/opencode/*)              mkdir -p "$profile_dir/config/${PWD#/opt/config/opencode/}" ;;
        "$HOME"/.config/opencode/*)          mkdir -p "$profile_dir/config/${PWD#$HOME/.config/opencode/}" ;;
        "$HOME"/.local/share/opencode/*)     mkdir -p "$profile_dir/data/${PWD#$HOME/.local/share/opencode/}" ;;
      esac
      [ ! -e "$profile_dir/config/skills" ] && [ -d "$SANDBOX_SKILLS" ] && ln -sfn "$SANDBOX_SKILLS" "$profile_dir/config/skills"

      [ -d "/opt/config/opencode" ] && mount_pairs+=("$profile_dir/config|/opt/config/opencode")
      if [ ! -L "$HOME/.config/opencode" ]; then
        mkdir -p "$HOME/.config/opencode"
        mount_pairs+=("$profile_dir/config|$HOME/.config/opencode")
      fi
      mkdir -p "$HOME/.local/share/opencode"
      mount_pairs+=("$profile_dir/data|$HOME/.local/share/opencode")

      env_vars+=(
        "OPENCODE_PROFILE=$profile_dir"
      )
      ;;

    opencode2)
      mkdir -p "$profile_dir"
      case "$PWD" in
        /opt/config/opencode2/*)           mkdir -p "$profile_dir/${PWD#/opt/config/opencode2/}" ;;
        "$HOME"/.config/opencode2/*)       mkdir -p "$profile_dir/${PWD#$HOME/.config/opencode2/}" ;;
        "$HOME"/.config/opencode-v2/*)     mkdir -p "$profile_dir/${PWD#$HOME/.config/opencode-v2/}" ;;
      esac
      [ ! -e "$profile_dir/skills" ] && [ -d "$SANDBOX_SKILLS" ] && ln -sfn "$SANDBOX_SKILLS" "$profile_dir/skills"

      [ -d "/opt/config/opencode2" ] && mount_pairs+=("$profile_dir|/opt/config/opencode2")
      if [ ! -L "$HOME/.config/opencode2" ]; then
        mkdir -p "$HOME/.config/opencode2"
        mount_pairs+=("$profile_dir|$HOME/.config/opencode2")
      fi
      if [ ! -L "$HOME/.config/opencode-v2" ]; then
        mkdir -p "$HOME/.config/opencode-v2"
        mount_pairs+=("$profile_dir|$HOME/.config/opencode-v2")
      fi

      env_vars+=(
        "OPENCODE_CONFIG_DIR=${OPENCODE2_CONFIG_DIR:-/opt/config/opencode2}"
        "OPENCODE2_CONFIG_DIR=${OPENCODE2_CONFIG_DIR:-/opt/config/opencode2}"
        "OPENCODE2_PROFILE=$profile_dir"
      )
      ;;

    pi)
      mkdir -p "$profile_dir"
      case "$PWD" in
        /opt/config/pi/*)       mkdir -p "$profile_dir/${PWD#/opt/config/pi/}" ;;
        "$HOME"/.pi/agent/*)    mkdir -p "$profile_dir/${PWD#$HOME/.pi/agent/}" ;;
      esac
      [ ! -e "$profile_dir/skills" ] && [ -d "$SANDBOX_SKILLS" ] && ln -sfn "$SANDBOX_SKILLS" "$profile_dir/skills"

      [ -d "/opt/config/pi" ] && mount_pairs+=("$profile_dir|/opt/config/pi")
      if [ ! -L "$HOME/.pi/agent" ]; then
        mkdir -p "$HOME/.pi/agent"
        mount_pairs+=("$profile_dir|$HOME/.pi/agent")
      fi

      env_vars+=(
        "PI_CODING_AGENT_DIR=${PI_CODING_AGENT_DIR:-/opt/config/pi}"
        "PI_PROFILE=$profile_dir"
      )
      ;;

    orca)
      # Multi-folder agent: user_data and home_orca subdirectories
      mkdir -p "$profile_dir/user_data" "$profile_dir/home_orca"
      case "$PWD" in
        /opt/config/orca/*)  mkdir -p "$profile_dir/user_data/${PWD#/opt/config/orca/}" ;;
        "$HOME"/.orca/*)     mkdir -p "$profile_dir/home_orca/${PWD#$HOME/.orca/}" ;;
      esac

      [ -d "/opt/config/orca" ] && mount_pairs+=("$profile_dir/user_data|/opt/config/orca")
      if [ ! -L "$HOME/orca_auto/config" ] && [ -d "$HOME/orca_auto" ]; then
        mkdir -p "$HOME/orca_auto/config"
        mount_pairs+=("$profile_dir/user_data|$HOME/orca_auto/config")
      fi
      mkdir -p "$HOME/.orca"
      mount_pairs+=("$profile_dir/home_orca|$HOME/.orca")

      env_vars+=(
        "ORCA_USER_DATA=/opt/config/orca"
        "ORCA_PROFILE=$profile_dir"
      )
      ;;
  esac

  # Build Bubblewrap Arguments
  local bwrap_args=(
    # System roots (read-only)
    --ro-bind /usr /usr
    --ro-bind-try /lib /lib
    --ro-bind-try /lib64 /lib64
    --ro-bind-try /bin /bin
    --ro-bind-try /sbin /sbin
    --ro-bind /etc /etc

    # Virtual filesystems
    --dev /dev
    --proc /proc
    --bind /tmp /tmp

    # Workspace (read-write per requirements)
    --bind-try /workspace /workspace

    # Caches & shared storage
    --bind-try /mnt/cache /mnt/cache
    --ro-bind-try /mnt/sharedCache /mnt/sharedCache

    # Tools tree (read-only)
    --ro-bind-try /opt /opt

    # Worktrunk state & approvals (read-write for lock files and approvals)
    --bind-try /opt/config/worktrunk /opt/config/worktrunk
    --bind-try "$HOME/.config/worktrunk" "$HOME/.config/worktrunk"

    # User Home
    --bind "$HOME" "$HOME"
  )

  # Apply agent-specific profile mounts
  for pair in "${mount_pairs[@]}"; do
    IFS='|' read -r src dst <<< "$pair"
    bwrap_args+=(--bind "$src" "$dst")
  done

  # Also expose the profile directory at its absolute path
  bwrap_args+=(--bind "$profile_dir" "$profile_dir")

  # Set base environment
  bwrap_args+=(
    --setenv HOME "$HOME"
    --setenv PATH "$PATH"
    --setenv USER "${USER:-$OWNER}"
    --setenv AGENT_SANDBOX_ACTIVE "1"
    --setenv AGENT_SANDBOX_AGENT "$agent"
    --setenv AGENT_SANDBOX_PROFILE "$profile"
    --setenv AGENT_SANDBOX_DIR "$profile_dir"
    --setenv AGENT_SANDBOX_IPV4 "$NET_VAL_ipv4"
    --setenv AGENT_SANDBOX_IPV6 "$NET_VAL_ipv6"
  )
  bwrap_args+=(${NET_BWRAP[@]+"${NET_BWRAP[@]}"})

  # Set agent-specific environment variables
  for ev in "${env_vars[@]}"; do
    local k="${ev%%=*}"
    local v="${ev#*=}"
    bwrap_args+=(--setenv "$k" "$v")
  done

  # Working directory
  bwrap_args+=(--chdir "$PWD")

  # Fallback dedicated IPv6: if the profile resolved to host networking and SANDBOX_IPV6 is set (in
  # $SANDBOX_BASE/net.env or AGENT_SANDBOX_NET_ENV), run under pasta bound to that address. Per-profile settings win.
  local net_env="${AGENT_SANDBOX_NET_ENV:-$SANDBOX_BASE/net.env}"
  [ -r "$net_env" ] && . "$net_env"
  if [ ${#NET_PREFIX[@]} -eq 0 ] && [ -n "${SANDBOX_IPV6:-}" ]; then
    net_need_pasta
    NET_PREFIX=(pasta --config-net -t none -u none -T none -U none -o "$SANDBOX_IPV6" --)
  fi

  # Execute agent binary inside Bubblewrap sandbox (net prefix = pasta, if any)
  if [ "$DRY_RUN" = 1 ]; then
    printf '%s\n' ${NET_PREFIX[@]+"${NET_PREFIX[@]}"} bwrap "${bwrap_args[@]}" "$real_bin" "${forward_args[@]}"
    exit 0
  fi
  exec ${NET_PREFIX[@]+"${NET_PREFIX[@]}"} bwrap "${bwrap_args[@]}" "$real_bin" "${forward_args[@]}"
}

# ------------------------------------------------------------------------------
# Main Dispatcher
# ------------------------------------------------------------------------------
main() {
  if [ $# -eq 0 ]; then
    usage
    exit 0
  fi

  # Top-level global flags
  case "$1" in
    -h|--help|help)
      usage
      exit 0
      ;;
    -V|--version|version)
      echo "agent-sandbox $AGENT_SANDBOX_VERSION"
      exit 0
      ;;
    --list-profile|--list-profiles|--list)
      list_profiles "all"
      exit 0
      ;;
    --auto-clean)
      shift
      local ac_agent=all ac_days=7 ac_dry=0 ac_yes=0 ac_int=0
      while [ $# -gt 0 ]; do
        case "$1" in
          --days)    ac_days="${2:-}"; shift $(( $# > 1 ? 2 : 1 )) ;;
          --days=*)  ac_days="${1#--days=}"; shift ;;
          --dry-run) ac_dry=1; shift ;;
          --yes)     ac_yes=1; shift ;;
          -i|--interactive) ac_int=1; shift ;;
          *)         ac_agent="$(resolve_agent "$1")"
                     [ -n "$ac_agent" ] || { echo "[agent-sandbox] ERROR: --auto-clean: unknown option or agent '$1'" >&2; exit 1; }
                     shift ;;
        esac
      done
      [[ "$ac_days" =~ ^[0-9]+$ ]] || { echo "[agent-sandbox] ERROR: --days needs a whole number" >&2; exit 1; }
      if [ "$ac_int" = 1 ]; then clean_interactive "$ac_agent" "$ac_days" "$ac_dry"; else auto_clean "$ac_agent" "$ac_days" "$ac_dry" "$ac_yes"; fi
      exit $?
      ;;
  esac

  local raw_agent="$1"
  shift

  local canonical_agent
  canonical_agent="$(resolve_agent "$raw_agent")"

  if [ -z "$canonical_agent" ]; then
    echo "[agent-sandbox] ERROR: Unknown agent '$raw_agent'" >&2
    echo "Supported agents: antigravity (agy), claude, codex, opencode, opencode2, pi, orca" >&2
    exit 1
  fi

  local is_list_profile=0
  local profile_arg=""
  local forward_args=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --list-profile|--list-profiles|--list)
        is_list_profile=1
        shift 1
        ;;
      --profile)
        if [ $# -lt 2 ]; then
          echo "[agent-sandbox] ERROR: --profile requires a profile name or directory path" >&2
          exit 1
        fi
        profile_arg="$2"
        shift 2
        ;;
      --profile=*)
        profile_arg="${1#--profile=}"
        shift 1
        ;;
      --ipv4|--ipv6)
        if [ $# -lt 2 ]; then
          echo "[agent-sandbox] ERROR: $1 requires a value (address, host, none, new or default)" >&2
          exit 1
        fi
        net_flag "$1" "$2"
        shift 2
        ;;
      --ipv4=*|--ipv6=*)
        net_flag "${1%%=*}" "${1#*=}"
        shift 1
        ;;
      *)
        forward_args+=("$1")
        shift 1
        ;;
    esac
  done

  # 1. Action: List profiles for this agent
  if [ "$is_list_profile" -eq 1 ]; then
    list_profiles "$canonical_agent"
    exit 0
  fi

  # 2. Action: Run with isolated profile
  if [ -n "$profile_arg" ]; then
    run_sandbox "$canonical_agent" "$profile_arg" "${forward_args[@]}"
  fi

  if [ -n "${NET_FLAG_ipv4:-}${NET_FLAG_ipv6:-}" ]; then
    echo "[agent-sandbox] ERROR: --ipv4/--ipv6 require --profile" >&2
    exit 1
  fi

  # 3. Action: Default — run agent command directly on host with arguments
  run_direct "$canonical_agent" "${forward_args[@]}"
}

main "$@"
